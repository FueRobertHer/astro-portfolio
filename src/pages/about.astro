---
import ButtonLink from "../components/ButtonLink.astro";
import Link from "../components/Link.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { education, resumeHref, roles } from "../data/experience";
---

<BaseLayout
  title="About | Fue Her"
  description="Learn about Fue Her, a full-stack engineer focused on accessible interfaces, reliable systems, and thoughtful web product development."
>
  <main id="main" class="py-12 sm:py-20">
    <section class="max-w-3xl animate-fade-up">
      <p class="text-sm font-bold uppercase text-accent dark:text-accent-dark">
        About
      </p>
      <h1
        class="mt-3 text-4xl font-black text-stone-950 sm:text-5xl dark:text-stone-50"
      >
        Hi, I&apos;m Fue.
      </h1>
      <p class="mt-5 text-lg leading-8 text-stone-600 dark:text-stone-300">
        My name is pronounced /fu:/, like &quot;food&quot; without the
        &quot;d&quot;. I&apos;m a full-stack engineer who likes building clear,
        useful software with teams that care about both people and craft.
      </p>
      <div class="mt-6">
        <ButtonLink
          href={resumeHref}
          variant="secondary"
          target="_blank"
          data-astro-prefetch="false"
        >
          Resume (PDF)
        </ButtonLink>
      </div>
    </section>

    <div class="mt-12 grid gap-8 lg:grid-cols-[0.72fr_1.28fr]">
      <aside
        class="h-fit rounded-md border border-stone-300 bg-stone-100/70 p-5 dark:border-stone-800 dark:bg-stone-900/70"
      >
        <h2 class="text-lg font-black text-stone-950 dark:text-stone-50">
          How I Work
        </h2>
        <ul
          class="mt-4 space-y-3 text-sm leading-6 text-stone-600 dark:text-stone-300"
        >
          <li>
            Start from the problem and the user, not a preferred tech stack.
          </li>
          <li>
            Make the tradeoffs explicit early: product, technical, and
            accessibility constraints up front.
          </li>
          <li>
            Ship in small, testable slices so work lands safely and early.
          </li>
          <li>
            Build for the next person: maintainable, accessible, easy to change.
          </li>
        </ul>
      </aside>

      <section class="space-y-8">
        <article>
          <h2 class="text-2xl font-black text-stone-950 dark:text-stone-50">
            Background
          </h2>
          <div
            class="mt-3 space-y-4 leading-8 text-stone-600 dark:text-stone-300"
          >
            <p>
              I moved into software engineering in 2019, and the years since
              have kept me close to both users and teams, building product
              features people use directly, and the platform tooling that helps
              teams ship better experiences over time.
            </p>
            <p>
              I started at Remesh (2020 to 2022), working across Django, React,
              and a Go ML pipeline, and taking the platform to WCAG A and AA
              compliance and 28+ languages. I then spent four years at Atlassian
              on Growth (2022 to 2026), where I led a machine-learning
              personalization program on high-traffic acquisition pages,
              designed and shipped contextual-bandit experiments, and built the
              content-platform capabilities internal marketing teams launched
              on.
            </p>
            <p>
              Right now I&apos;m building projects that let me own the whole
              stack, and looking for a team where product judgment and
              engineering craft both carry weight.
            </p>
          </div>
        </article>

        <article>
          <h2 class="text-2xl font-black text-stone-950 dark:text-stone-50">
            Experience
          </h2>
          <ol
            class="mt-4 space-y-6 border-l-2 border-stone-300 pl-5 dark:border-stone-800"
          >
            {
              roles.map((role) => (
                <li class="relative">
                  <span
                    class="absolute -left-[1.6875rem] top-2 size-2.5 rounded-full bg-accent dark:bg-accent-dark"
                    aria-hidden="true"
                  />
                  <h3 class="font-black text-stone-950 dark:text-stone-50">
                    {role.title}
                    <span class="font-bold text-stone-600 dark:text-stone-300">
                      {" "}
                      &middot; {role.company}
                    </span>
                  </h3>
                  <p class="text-sm text-stone-600 dark:text-stone-300">
                    {role.dates}
                  </p>
                  <ul class="mt-2 space-y-2 text-sm leading-6 text-stone-600 dark:text-stone-300">
                    {role.highlights.map((highlight) => (
                      <li>{highlight}</li>
                    ))}
                  </ul>
                </li>
              ))
            }
          </ol>
          <h3 class="mt-8 font-black text-stone-950 dark:text-stone-50">
            Education
          </h3>
          <ul
            class="mt-2 space-y-1 text-sm leading-6 text-stone-600 dark:text-stone-300"
          >
            {
              education.map((item) => (
                <li>
                  <span class="font-bold text-stone-800 dark:text-stone-100">
                    {item.name}
                  </span>
                  , {item.school}, {item.year}
                </li>
              ))
            }
          </ul>
        </article>

        <article class="group">
          <h2 class="text-2xl font-black text-stone-950 dark:text-stone-50">
            Outside Code
          </h2>
          <div
            class="mt-3 space-y-4 leading-8 text-stone-600 dark:text-stone-300"
          >
            <p>
              When I&apos;m not coding, you&apos;ll probably still find me at
              the computer playing video games, reading the latest web novel
              I&apos;m following, or watching{" "}
              <Link href="https://www.dropout.tv/game-changer" target="_blank">
                Game Changer.
              </Link>
            </p>
            <p>
              Away from a screen, I spend time with my partner gardening,
              cooking, or taking in nature on a hike.
            </p>
          </div>
          <img
            src="/sam.png"
            alt=""
            height="100"
            width="108"
            loading="lazy"
            decoding="async"
            aria-hidden="true"
            class="pointer-events-none fixed bottom-1 right-1 z-10 w-20 translate-y-8 opacity-0 transition-all duration-700 ease-out group-has-[a:hover]:translate-y-0 group-has-[a:hover]:opacity-100 group-has-[a:focus-visible]:translate-y-0 group-has-[a:focus-visible]:opacity-100"
          />
        </article>
      </section>
    </div>
  </main>
</BaseLayout>
