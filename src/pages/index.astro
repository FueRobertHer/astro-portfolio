---
import BaseLayout from "../layouts/BaseLayout.astro";
import CurrentlyPanel from "../components/CurrentlyPanel.astro";
import SocialLinks from "../components/SocialLinks.astro";
import ButtonLink from "../components/ButtonLink.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { featuredProjects } from "../data/projects";
import { resumeHref } from "../data/experience";
---

<BaseLayout
  title="Fue Her | Full Stack Engineer"
  description="Fue Her is a full-stack engineer building reliable, accessible web products with Astro, React, TypeScript, and practical product judgment."
>
  <main id="main">
    <section
      class="grid items-center gap-8 py-12 sm:py-16 lg:grid-cols-[1.08fr_0.92fr] lg:py-20"
    >
      <div class="max-w-3xl animate-fade-up">
        <p
          class="text-xs font-bold uppercase text-accent sm:text-sm dark:text-accent-dark"
        >
          Fue Her &middot; Full Stack Engineer
        </p>
        <h1
          class="mt-3 max-w-3xl text-[clamp(1.875rem,9vw,2.25rem)] font-black leading-tight text-stone-950 sm:text-5xl dark:text-stone-50"
        >
          {
            /* Kept on one line so it never splits at the hyphen, but only once
              the screen is 20rem wide: rem media queries follow the user's
              font size, so larger text can still wrap instead of scrolling. */
          }
          I build <span
            class="text-accent min-[20rem]:whitespace-nowrap dark:text-accent-dark"
            >growth-focused</span
          > web products at scale.
        </h1>
        <p
          class="mt-4 max-w-2xl text-base leading-7 text-stone-600 sm:text-lg dark:text-stone-300"
        >
          Across the frontend and backend, I&apos;ve shipped machine-learning
          personalization on surfaces that reach millions, accessible interfaces
          that hold up to WCAG A and AA, and the platform tooling that helps
          teams move faster.
        </p>
        {
          /* On phones the three buttons share one row, stretching to fill it;
            narrower screens wrap them into even rows instead. */
        }
        <div
          class="mt-6 flex flex-wrap items-center gap-2 sm:gap-3 [&>a]:grow [&>a]:max-sm:px-3 sm:[&>a]:grow-0"
        >
          <ButtonLink href="/projects/" variant="primary">
            See my work
          </ButtonLink>
          <ButtonLink href="mailto:fueroberther@gmail.com" variant="secondary">
            Get in touch
          </ButtonLink>
          <ButtonLink
            href={resumeHref}
            variant="secondary"
            target="_blank"
            data-astro-prefetch="false"
          >
            Resume<span class="sr-only"> (PDF)</span>
          </ButtonLink>
        </div>
        <div class="mt-6">
          <SocialLinks />
        </div>
      </div>

      <CurrentlyPanel />
    </section>

    <section class="pb-12 sm:pb-20" aria-labelledby="featured-work">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p
            class="text-sm font-bold uppercase text-accent dark:text-accent-dark"
          >
            Selected work
          </p>
          <h2
            id="featured-work"
            class="mt-2 text-2xl font-black text-stone-950 sm:text-3xl dark:text-stone-50"
          >
            What I&apos;ve been building.
          </h2>
        </div>
        <a
          href="/projects/"
          class="text-sm font-bold text-accent underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent dark:text-accent-dark dark:focus-visible:outline-accent-dark"
        >
          All projects<span aria-hidden="true"> &rarr;</span>
        </a>
      </div>

      <div class="mt-6 grid gap-5 lg:grid-cols-3">
        {
          featuredProjects.map((project) => (
            <ProjectCard project={project} compact headingLevel={3} />
          ))
        }
      </div>
    </section>
  </main>
</BaseLayout>
