---
import BaseLayout from "../layouts/BaseLayout.astro";
import CurrentlyPanel from "../components/CurrentlyPanel.astro";
import SocialLinks from "../components/SocialLinks.astro";
import ButtonLink from "../components/ButtonLink.astro";
---

<BaseLayout
  title="Fue Her | Full Stack Engineer"
  description="Fue Her is a full-stack engineer building reliable, accessible web products with Astro, React, TypeScript, and practical product judgment."
>
  <main>
    <section
      class="grid items-center gap-8 py-12 sm:grid-cols-[1.08fr_0.92fr] sm:py-16 lg:py-20"
    >
      <div class="max-w-3xl animate-fade-up">
        <p
          class="text-xs font-bold uppercase text-accent sm:text-sm dark:text-accent-dark"
        >
          Full Stack Engineer
        </p>
        <h1
          class="mt-3 max-w-3xl text-4xl font-black leading-tight text-stone-950 sm:text-5xl dark:text-stone-50"
        >
          Fue Her builds <span class="text-accent dark:text-accent-dark"
            >growth-focused</span
          > web products at scale.
        </h1>
        <p
          class="mt-4 max-w-2xl text-base leading-7 text-stone-600 sm:text-lg dark:text-stone-300"
        >
          I work across the frontend and backend of high-traffic marketing
          surfaces, running experiments, shipping accessible interfaces, and
          building the platform tools that help teams move faster.
        </p>
        <div class="mt-6 flex flex-wrap items-center gap-3">
          <ButtonLink href="/about" variant="primary">Read about me</ButtonLink>
          <ButtonLink href="mailto:fueroberther@gmail.com" variant="secondary">
            Get in touch
          </ButtonLink>
        </div>
        <div class="mt-6">
          <SocialLinks />
        </div>
      </div>

      <CurrentlyPanel />
    </section>
  </main>
</BaseLayout>
