---
export interface Props {
 href: string;
}

const { href } = Astro.props;

// Pages build to /about/index.html, so the runtime pathname carries a
// trailing slash the hrefs above don't. Compare them normalized, or the
// active-page indicator never lights up anywhere but the home page.
const normalize = (value: string) =>
  value.length > 1 && value.endsWith("/") ? value.slice(0, -1) : value;
const isActive = normalize(Astro.url.pathname) === normalize(href);
---

<a
  href={href}
  aria-current={isActive ? "page" : undefined}
  class={`border-b-2 py-2 text-sm font-bold uppercase transition-colors focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent dark:focus-visible:outline-accent-dark ${isActive ? "border-accent text-accent dark:border-accent-dark dark:text-accent-dark" : "border-transparent hover:border-stone-400 hover:text-accent dark:hover:border-stone-600 dark:hover:text-accent-dark"}`}
>
  <slot />
</a>
