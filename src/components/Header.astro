---
import Logo from "./Logo.astro";
import NavLink from "./NavLink.astro";
import Menu from "./Menu.astro";
import ThemeToggleButton from "./ThemeToggleButton.astro";

interface Link {
  text: string;
  href: string;
}

const links: Link[] = [
  {
    text: "Home",
    href: "/",
  },
  {
    text: "Projects",
    href: "/projects/",
  },
  {
    text: "About",
    href: "/about/",
  },
];
---

<header class="flex w-full items-center justify-between px-5 py-3 sm:px-8">
  <a class="size-8" href="/" aria-label="Fue Her home">
    <Logo />
  </a>
  <div class="hidden items-center sm:flex">
    <nav aria-label="Main">
      <ul class="flex items-center">
        {
          links.map((link) => (
            <li class="mx-4">
              <NavLink href={link.href}>{link.text}</NavLink>
            </li>
          ))
        }
      </ul>
    </nav>
    <span class="mx-4">
      <ThemeToggleButton />
    </span>
  </div>
  <div class="sm:hidden">
    <Menu>
      <div class="flex flex-col items-center gap-4 text-lg">
        <ThemeToggleButton />
        <nav aria-label="Main">
          <ul class="flex flex-col items-center gap-4">
            {
              links.map((link) => (
                <li>
                  <NavLink href={link.href}>{link.text}</NavLink>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </Menu>
  </div>
</header>
