---
const props = Astro.props;
const href = props.href ?? "";
const isExternal = href.startsWith("http");
const rel =
  props.rel ??
  (props.target === "_blank" || isExternal ? "noopener noreferrer" : undefined);
---

<a
  class={`text-accent underline decoration-1 underline-offset-4 hover:decoration-2 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent dark:text-accent-dark dark:focus-visible:outline-accent-dark ${props.class ?? ""}`}
  href={props.href}
  target={props.target}
  rel={rel}
>
  <slot />{
    props.target === "_blank" && (
      <span class="sr-only"> (opens in a new tab)</span>
    )
  }
</a>
