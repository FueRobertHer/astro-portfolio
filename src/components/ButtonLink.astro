---
export interface Props {
  href: string;
  variant?: "primary" | "secondary" | "ghost";
  target?: string;
  class?: string;
}

const {
  href,
  variant = "primary",
  target,
  class: className = "",
} = Astro.props;

const isExternal = href.startsWith("http");
const rel = target === "_blank" || isExternal ? "noopener noreferrer" : undefined;

const variants = {
  primary:
    "border-accent bg-accent text-white hover:border-accent-dark hover:bg-accent-dark dark:border-accent-dark dark:bg-accent-dark dark:hover:border-accent dark:hover:bg-accent",
  secondary:
    "border-stone-500 text-stone-800 hover:border-accent hover:text-accent dark:border-stone-500 dark:text-stone-100 dark:hover:border-accent-dark dark:hover:text-accent-dark",
  ghost:
    "border-transparent text-stone-700 hover:text-accent dark:text-stone-200 dark:hover:text-accent-dark",
};
---

<a
  href={href}
  target={target}
  rel={rel}
  class={`inline-flex min-h-11 items-center justify-center rounded-md border px-4 py-2 text-sm font-bold transition-colors focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent dark:focus-visible:outline-accent-dark ${variants[variant]} ${className}`}
>
  <slot />
</a>
