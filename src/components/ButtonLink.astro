---
import type { HTMLAttributes } from "astro/types";

export interface Props extends HTMLAttributes<"a"> {
  href: string;
  variant?: "primary" | "secondary" | "ghost";
}

const {
  href,
  variant = "primary",
  target,
  class: className = "",
  ...attrs
} = Astro.props;

const isExternal = href.startsWith("http");
const rel = target === "_blank" || isExternal ? "noopener noreferrer" : undefined;

const variants = {
  primary:
    "border-accent bg-accent text-white shadow-sm shadow-accent/20 hover:border-accent-dark-strong hover:bg-accent-dark-strong hover:shadow-md hover:shadow-accent-dark-strong/20 dark:border-accent-dark-strong dark:bg-accent-dark-strong dark:shadow-accent-dark-strong/20 dark:hover:border-accent dark:hover:bg-accent",
  secondary:
    "border-stone-400 bg-stone-100/50 text-stone-800 hover:border-accent hover:bg-stone-100 hover:text-accent dark:border-stone-700 dark:bg-stone-900/50 dark:text-stone-100 dark:hover:border-accent-dark dark:hover:bg-stone-900 dark:hover:text-accent-dark",
  ghost:
    "border-transparent text-stone-700 hover:text-accent dark:text-stone-200 dark:hover:text-accent-dark",
};
---

<a
  href={href}
  target={target}
  rel={rel}
  {...attrs}
  class={`inline-flex min-h-11 items-center justify-center rounded-md border px-4 py-2 text-sm font-bold transition-colors focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent dark:focus-visible:outline-accent-dark ${variants[variant]} ${className}`}
>
  <slot />
  {target === "_blank" && <span class="sr-only"> (opens in a new tab)</span>}
</a>
