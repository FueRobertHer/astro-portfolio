<div>
  <button
    type="button"
    data-menu-open
    title="Open navigation menu"
    aria-label="Open navigation menu"
    aria-haspopup="dialog"
    class="inline-flex size-11 items-center justify-center rounded-md border border-stone-300 text-stone-800 transition-colors hover:border-accent hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent dark:border-stone-700 dark:text-stone-200 dark:hover:border-accent-dark dark:hover:text-accent-dark dark:focus-visible:outline-accent-dark"
  >
    <svg
      class="size-[22px]"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.25"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M4 5h16M4 12h16M4 19h16"></path>
    </svg>
  </button>
  <dialog
    data-menu-dialog
    aria-label="Navigation menu"
    class="relative mx-auto mt-8 w-10/12 rounded-md border border-stone-300 bg-stone-50 text-stone-700 backdrop:bg-black backdrop:opacity-20 dark:border-stone-800 dark:bg-stone-950 dark:text-stone-200 dark:backdrop:opacity-50"
  >
    <div data-menu-panel class="px-8 py-12">
      <button
        type="button"
        data-menu-close
        title="Close menu"
        aria-label="Close menu"
        class="absolute right-2 top-2 flex size-11 items-center justify-center rounded-md text-stone-700 transition-colors hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent dark:text-stone-200 dark:hover:text-accent-dark dark:focus-visible:outline-accent-dark"
      >
        <svg
          class="size-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.25"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M18 6 6 18M6 6l12 12"></path>
        </svg>
      </button>
      <slot />
    </div>
  </dialog>
</div>

<script>
  const dialog =
    document.querySelector<HTMLDialogElement>("[data-menu-dialog]");
  const panel = dialog?.querySelector("[data-menu-panel]");

  document
    .querySelector("[data-menu-open]")
    ?.addEventListener("click", () => dialog?.showModal());
  dialog
    ?.querySelector("[data-menu-close]")
    ?.addEventListener("click", () => dialog.close());
  // A click that lands outside the panel hit the backdrop.
  dialog?.addEventListener("click", (event) => {
    if (panel && !panel.contains(event.target as Node)) dialog.close();
  });
</script>
