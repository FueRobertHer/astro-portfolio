<aside
  class="w-full animate-fade-up rounded-md border border-stone-300 border-t-2 border-t-accent bg-stone-100/80 p-4 shadow-[0_1rem_3rem_rgba(28,28,28,0.08)] [animation-delay:120ms] dark:border-stone-800 dark:border-t-accent-dark dark:bg-stone-900/80"
  aria-label="Current engineering focus"
>
  <div class="flex items-center justify-between">
    <p class="text-xs font-bold uppercase text-accent dark:text-accent-dark">
      Currently
    </p>
    <div class="flex items-center gap-1.5" title="Available for opportunities">
      {
        /* Pulses three times, then rests: an endless pulse keeps the page
          rendering every frame, which made scrolling lag on phones. */
      }
      <span class="relative flex size-2.5">
        <span
          class="absolute inline-flex h-full w-full animate-[ping_1s_cubic-bezier(0,0,0.2,1)_3_forwards] rounded-full bg-emerald-400 opacity-75"
        ></span>
        <span class="relative inline-flex size-2.5 rounded-full bg-emerald-500"
        ></span>
      </span>
      <span class="text-xs font-semibold text-emerald-700 dark:text-emerald-400"
        >Open to opportunities</span
      >
    </div>
  </div>
  <h2
    class="mt-2 text-lg font-black leading-6 text-stone-900 dark:text-stone-100"
  >
    Open to any role doing meaningful work with a positive impact, alongside
    great people in a collaborative team.
  </h2>
</aside>
