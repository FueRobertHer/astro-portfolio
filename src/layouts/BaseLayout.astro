---
import Header from "../components/Header.astro";
import Link from "../components/Link.astro";
import "@fontsource-variable/inter/wght.css";
import interLatin from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import "../styles/global.css";

export interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  // Keep a page out of search results (the hidden playground, the 404).
  noindex?: boolean;
}

const defaultImage = { src: "/og.png", width: 1200, height: 630 };
const {
  title,
  description,
  image = defaultImage.src,
  imageAlt = "Fue Her, Full Stack Engineer. I build growth-focused web products at scale.",
  noindex = false,
} = Astro.props;
const site = Astro.site ?? new URL("https://fueher.com");
const canonicalURL = new URL(Astro.url.pathname, site).toString();
const imageURL = new URL(image, site).toString();
// Only the default image has known dimensions.
const imageSize = image === defaultImage.src ? defaultImage : undefined;
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Fue Her",
  url: site.toString(),
  jobTitle: "Full Stack Engineer",
  sameAs: [
    "https://github.com/FueRobertHer",
    "https://www.linkedin.com/in/fue-her/",
  ],
  knowsAbout: [
    "Astro",
    "React",
    "TypeScript",
    "Tailwind CSS",
    "Accessibility",
    "Full-stack web development",
  ],
};
---

<!doctype html>
<html lang="en" class="font-sans">
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Fue Her" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      rel="preload"
      href={interLatin}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="msapplication-config" content="/browserconfig.xml" />
    <meta name="msapplication-TileColor" content="#fafaf9" />
    <meta
      name="theme-color"
      content="#e7e5e4"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#0c0a09"
      media="(prefers-color-scheme: dark)"
    />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex" />}
    {
      // A noindex page has no URL worth pointing at; the 404 in particular
      // would claim /404/, which isn't a real route.
      !noindex && <link rel="canonical" href={canonicalURL} />
    }
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonicalURL} />}
    <meta property="og:image" content={imageURL} />
    {
      imageSize && (
        <>
          <meta property="og:image:width" content={String(imageSize.width)} />
          <meta property="og:image:height" content={String(imageSize.height)} />
        </>
      )
    }
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(personSchema)}
    />

    <!-- inline to prevent FOUC -->
    <script is:inline>
      (function () {
        const systemDark = window.matchMedia("(prefers-color-scheme: dark)");
        // Storage can throw (blocked site data), which would otherwise leave
        // the page on the wrong theme.
        const storedTheme = function () {
          try {
            return localStorage.getItem("theme");
          } catch (error) {
            return null;
          }
        };
        const preferredTheme = function () {
          const stored = storedTheme();
          if (stored === "dark" || stored === "light") return stored;
          return systemDark.matches ? "dark" : "light";
        };
        // Also used by ThemeToggleButton. Keeps the browser UI color (mobile
        // address bar) in step with the chosen theme, not just the OS one.
        window.__applyTheme = function (theme) {
          document.documentElement.classList.toggle("dark", theme === "dark");
          const color = theme === "dark" ? "#0c0a09" : "#e7e5e4";
          document
            .querySelectorAll('meta[name="theme-color"]')
            .forEach(function (meta) {
              meta.setAttribute("content", color);
            });
        };
        window.__applyTheme(preferredTheme());
        // With no saved choice, follow the system theme live.
        systemDark.addEventListener("change", function () {
          if (!storedTheme()) {
            window.__applyTheme(preferredTheme());
          }
        });
      })();
    </script>

    <!-- Vercel Web Analytics (equivalent to the <Analytics /> component). -->
    <!-- PROD-gated: the analytics endpoint 404s outside real Vercel deploys. -->
    <script>
      import { inject } from "@vercel/analytics";
      if (import.meta.env.PROD) {
        inject();
      }
    </script>
  </head>
  <body
    class="flex min-h-screen min-w-full flex-col items-center bg-stone-200 p-3 text-stone-700 sm:p-6 sm:pb-3 dark:bg-stone-950 dark:text-stone-200"
  >
    <a
      href="#main"
      class="sr-only rounded-md bg-accent px-4 py-2 text-sm font-bold text-white focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 dark:bg-accent-dark"
    >
      Skip to content
    </a>
    <div
      class="relative flex w-full max-w-full grow flex-col items-center rounded-md border border-stone-300 bg-stone-50 shadow-[0_0_2rem_rgba(28,28,28,0.08)] sm:max-w-screen-2xl dark:border-stone-800 dark:bg-stone-950 dark:shadow-[0_0_2rem_rgba(0,0,0,0.28)]"
    >
      <Header />

      <div class="w-full max-w-6xl px-5 sm:px-10">
        <slot />
      </div>
    </div>
    <footer class="m-3">
      <p
        class="text-center text-xs text-stone-600 sm:text-sm dark:text-stone-400"
      >
        Designed and built by Fue Her. Made with{" "}
        <Link href="https://astro.build/" target="_blank">Astro</Link> and{" "}
        <Link href="https://tailwindcss.com/" target="_blank">Tailwind CSS</Link
        >, deployed on{" "}
        <Link href="https://vercel.com" target="_blank">Vercel</Link>.
      </p>
    </footer>

    <!-- Tracks total time on the site, persisted in localStorage. -->
    <script is:inline>
      (function () {
        const KEY = "fh:seconds-on-site";
        let seconds = 0;
        try {
          seconds = parseInt(window.localStorage.getItem(KEY) || "0", 10);
        } catch (error) {}
        if (Number.isNaN(seconds)) seconds = 0;
        let timer = null;

        function persist() {
          try {
            window.localStorage.setItem(KEY, String(seconds));
          } catch (error) {}
        }
        function tick() {
          seconds += 1;
          // Persist occasionally rather than every second — pagehide and
          // visibilitychange below catch the rest, and once-a-second
          // localStorage writes cost battery on mobile.
          if (seconds % 15 === 0) persist();
          document.dispatchEvent(
            new CustomEvent("fh:seconds", { detail: seconds }),
          );
        }
        function start() {
          if (timer === null && document.visibilityState === "visible") {
            timer = window.setInterval(tick, 1000);
          }
        }
        function stop() {
          if (timer !== null) {
            window.clearInterval(timer);
            timer = null;
          }
        }

        document.addEventListener("visibilitychange", function () {
          if (document.visibilityState === "visible") {
            start();
          } else {
            stop();
            persist();
          }
        });
        window.addEventListener("pagehide", persist);
        window.__secondsOnSite = function () {
          return seconds;
        };
        start();
      })();
    </script>

    <!-- A hello for the curious devs who open the console. -->
    <script is:inline>
      console.log(
        "%c👋 Hey, curious explorer!%c\nHave fun poking around.\nHere's my secret playground for games and experiments:\n\n" +
          location.origin +
          "/playground\n\nPsst, you can also try the Konami code (keyboard) or wiggle a finger up and down fast (touch).\n\n↑ ↑ ↓ ↓ ← → ← → B A",
        "font-size:15px;font-weight:700;color:#2d5db0",
        "font-size:12px;line-height:1.5;color:inherit",
      );
    </script>

    <!-- Konami code → a quick confetti burst. -->
    <script>
      const sequence = [
        "ArrowUp",
        "ArrowUp",
        "ArrowDown",
        "ArrowDown",
        "ArrowLeft",
        "ArrowRight",
        "ArrowLeft",
        "ArrowRight",
        "b",
        "a",
      ];
      let position = 0;

      function launchConfetti() {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches)
          return;

        const canvas = document.createElement("canvas");
        canvas.style.cssText =
          "position:fixed;inset:0;width:100%;height:100%;pointer-events:none;z-index:9999";
        document.body.appendChild(canvas);

        const maybeCtx = canvas.getContext("2d");
        if (!maybeCtx) {
          canvas.remove();
          return;
        }
        const ctx: CanvasRenderingContext2D = maybeCtx;
        const dpr = window.devicePixelRatio || 1;
        canvas.width = window.innerWidth * dpr;
        canvas.height = window.innerHeight * dpr;

        const colors = ["#2d5db0", "#e05243", "#f4b400", "#0f9d58", "#ffffff"];
        const pieces = Array.from({ length: 150 }, () => ({
          x: Math.random() * canvas.width,
          y: -canvas.height * 0.3 * Math.random() - 20,
          size: (6 + Math.random() * 6) * dpr,
          color: colors[(Math.random() * colors.length) | 0],
          vx: (Math.random() - 0.5) * 3 * dpr,
          vy: (2 + Math.random() * 4) * dpr,
          rot: Math.random() * Math.PI,
          vr: (Math.random() - 0.5) * 0.3,
        }));

        const start = performance.now();
        function frame(now: number) {
          const elapsed = now - start;
          ctx.clearRect(0, 0, canvas.width, canvas.height);
          for (const p of pieces) {
            p.vy += 0.05 * dpr;
            p.x += p.vx;
            p.y += p.vy;
            p.rot += p.vr;
            ctx.save();
            ctx.translate(p.x, p.y);
            ctx.rotate(p.rot);
            ctx.fillStyle = p.color;
            ctx.fillRect(-p.size / 2, -p.size / 2, p.size, p.size * 0.6);
            ctx.restore();
          }
          if (elapsed < 2800) requestAnimationFrame(frame);
          else canvas.remove();
        }
        requestAnimationFrame(frame);
      }

      window.addEventListener("keydown", (event) => {
        const key = event.key.length === 1 ? event.key.toLowerCase() : event.key;
        if (key === sequence[position]) {
          position += 1;
          if (position === sequence.length) {
            position = 0;
            launchConfetti();
          }
        } else {
          position = key === sequence[0] ? 1 : 0;
        }
      });

      // Touch: a quick up-down wiggle. Six alternating vertical strokes,
      // each starting soon after the last, fire the same confetti. Strokes
      // can be one continuous zigzag or separate swipes; normal scrolling
      // rarely reverses that fast, that many times.
      type Stroke = "up" | "down";
      const WIGGLE_STROKES = 6;
      const MAX_STROKE_GAP_MS = 450;
      const MIN_STROKE_DISTANCE = 24;
      let strokeCount = 0;
      let lastStroke: Stroke | null = null;
      let lastStrokeTime = 0;
      let activeTouchId: number | null = null;
      // Pinch-zoom shifts touch coordinates up and down, so any multi-touch
      // gesture cancels the wiggle until every finger lifts.
      let multiTouch = false;
      // Where the current stroke turned around. It follows the finger while
      // it keeps going the same way, so a reversal is measured from the
      // stroke's far end rather than from where the touch began.
      let anchorX = 0;
      let anchorY = 0;

      function registerStroke(stroke: Stroke) {
        const now = performance.now();
        strokeCount =
          now - lastStrokeTime <= MAX_STROKE_GAP_MS ? strokeCount + 1 : 1;
        lastStroke = stroke;
        lastStrokeTime = now;
        if (strokeCount >= WIGGLE_STROKES) {
          strokeCount = 0;
          lastStroke = null;
          launchConfetti();
        }
      }

      function trackTouch(x: number, y: number) {
        const dx = x - anchorX;
        const dy = y - anchorY;
        const stroke: Stroke = dy > 0 ? "down" : "up";
        if (stroke === lastStroke) {
          // Still the same stroke: extend it.
          anchorX = x;
          anchorY = y;
          return;
        }
        // Ignore small jitter and mostly sideways movement.
        if (Math.abs(dy) < MIN_STROKE_DISTANCE || Math.abs(dy) < Math.abs(dx))
          return;
        anchorX = x;
        anchorY = y;
        registerStroke(stroke);
      }

      function findActiveTouch(touches: TouchList): Touch | null {
        for (let i = 0; i < touches.length; i++) {
          if (touches[i].identifier === activeTouchId) return touches[i];
        }
        return null;
      }

      window.addEventListener(
        "touchstart",
        (event) => {
          if (event.touches.length > 1) {
            multiTouch = true;
            activeTouchId = null;
            strokeCount = 0;
            lastStroke = null;
          }
          if (multiTouch) return;
          const touch = event.changedTouches[0];
          if (!touch) return;
          activeTouchId = touch.identifier;
          // A stale stroke from an earlier gesture shouldn't swallow the
          // first stroke of a new wiggle.
          if (performance.now() - lastStrokeTime > MAX_STROKE_GAP_MS)
            lastStroke = null;
          anchorX = touch.clientX;
          anchorY = touch.clientY;
        },
        { passive: true },
      );

      window.addEventListener(
        "touchmove",
        (event) => {
          const touch = findActiveTouch(event.changedTouches);
          if (touch) trackTouch(touch.clientX, touch.clientY);
        },
        { passive: true },
      );

      // A fast flick can end with few or no touchmove events, and a fling
      // handed off to native scrolling ends in touchcancel, so check the
      // final position on both.
      function handleTouchEnd(event: TouchEvent) {
        if (multiTouch) {
          if (event.touches.length === 0) multiTouch = false;
          return;
        }
        const touch = findActiveTouch(event.changedTouches);
        if (touch) trackTouch(touch.clientX, touch.clientY);
        activeTouchId = null;
      }

      window.addEventListener("touchend", handleTouchEnd, { passive: true });
      window.addEventListener("touchcancel", handleTouchEnd, {
        passive: true,
      });
    </script>
  </body>
</html>
