---
import Header from "../components/Header.astro";
import Link from "../components/Link.astro";
import "../styles/global.css";

export interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image = "/FH-150x150.png" } = Astro.props;
const site = Astro.site ?? new URL("https://fueher.com");
const canonicalURL = new URL(Astro.url.pathname, site).toString();
const imageURL = new URL(image, site).toString();
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Fue Her",
  url: site.toString(),
  jobTitle: "Full Stack Engineer",
  sameAs: [
    "https://github.com/FueRobertHer",
    "https://www.linkedin.com/in/fue-her/",
  ],
  knowsAbout: [
    "Astro",
    "React",
    "TypeScript",
    "Tailwind CSS",
    "Accessibility",
    "Full-stack web development",
  ],
};
---

<!doctype html>
<html lang="en" class="font-sans">
  <head>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta charset="UTF-8" />
    <meta name="author" content="Fue Her" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="keywords"
      content="HTML, CSS, JavaScript, TypeScript, software engineer, full-stack, React, Astro, Tailwind CSS, accessibility, portfolio"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&display=optional"
    />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="msapplication-config" content="/browserconfig.xml" />
    <meta name="msapplication-TileColor" content="#fafaf9" />
    <meta
      name="theme-color"
      content="#e7e5e4"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#0c0a09"
      media="(prefers-color-scheme: dark)"
    />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(personSchema)}
    />

    <!-- inline to prevent FOUC -->
    <script is:inline>
      const root = document.documentElement;
      const theme = localStorage.getItem("theme");
      if (
        theme === "dark" ||
        (!theme && window.matchMedia("(prefers-color-scheme: dark)").matches)
      ) {
        root.classList.add("dark");
      } else {
        root.classList.remove("dark");
      }
    </script>

    <!-- Vercel Web Analytics (equivalent to the <Analytics /> component). -->
    <script>
      import { inject } from "@vercel/analytics";
      inject();
    </script>
  </head>
  <body
    class="flex min-h-screen min-w-full flex-col items-center bg-stone-200 p-3 text-stone-700 sm:p-6 sm:pb-3 dark:bg-stone-950 dark:text-stone-200"
  >
    <div
      class="relative flex w-full max-w-full grow flex-col items-center rounded-md border border-stone-300 bg-stone-50 shadow-[0_0_2rem_rgba(28,28,28,0.08)] sm:max-w-screen-2xl dark:border-stone-800 dark:bg-stone-950 dark:shadow-[0_0_2rem_rgba(0,0,0,0.28)]"
    >
      <Header />

      <div class="w-full max-w-6xl px-5 sm:px-10">
        <slot />
      </div>
    </div>
    <footer class="m-3">
      <p
        class="text-center text-xs text-stone-600 sm:text-sm dark:text-stone-400"
      >
        Designed and built by Fue Her. Made with
        <Link href="https://astro.build/" target="_blank">Astro</Link> and
        <Link href="https://tailwindcss.com/" target="_blank">Tailwind CSS</Link
        >, deployed on
        <Link href="https://vercel.com" target="_blank">Vercel</Link>.
      </p>
    </footer>

    <!-- Tracks total time on the site, persisted in localStorage. -->
    <script is:inline>
      (function () {
        const KEY = "fh:seconds-on-site";
        let seconds = parseInt(window.localStorage.getItem(KEY) || "0", 10);
        if (Number.isNaN(seconds)) seconds = 0;
        let timer = null;

        function persist() {
          window.localStorage.setItem(KEY, String(seconds));
        }
        function tick() {
          seconds += 1;
          // Persist occasionally rather than every second — pagehide and
          // visibilitychange below catch the rest, and once-a-second
          // localStorage writes cost battery on mobile.
          if (seconds % 15 === 0) persist();
          document.dispatchEvent(
            new CustomEvent("fh:seconds", { detail: seconds }),
          );
        }
        function start() {
          if (timer === null && document.visibilityState === "visible") {
            timer = window.setInterval(tick, 1000);
          }
        }
        function stop() {
          if (timer !== null) {
            window.clearInterval(timer);
            timer = null;
          }
        }

        document.addEventListener("visibilitychange", function () {
          if (document.visibilityState === "visible") {
            start();
          } else {
            stop();
            persist();
          }
        });
        window.addEventListener("pagehide", persist);
        window.__secondsOnSite = function () {
          return seconds;
        };
        start();
      })();
    </script>

    <!-- A hello for the curious devs who open the console. -->
    <script is:inline>
      console.log(
        "%c👋 Hey, curious explorer!%c\nHave fun poking around.\nHere's my secret playground for games and experiments:\n\n" +
          location.origin +
          "/playground\n\nPsst, you can also try the Konami code (keyboard) or swipe it (touch).\n\n↑ ↑ ↓ ↓ ← → ← → B A",
        "font-size:15px;font-weight:700;color:#2d5db0",
        "font-size:12px;line-height:1.5;color:inherit",
      );
    </script>

    <!-- Konami code → a quick confetti burst. -->
    <script>
      const sequence = [
        "ArrowUp",
        "ArrowUp",
        "ArrowDown",
        "ArrowDown",
        "ArrowLeft",
        "ArrowRight",
        "ArrowLeft",
        "ArrowRight",
        "b",
        "a",
      ];
      let position = 0;

      function launchConfetti() {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches)
          return;

        const canvas = document.createElement("canvas");
        canvas.style.cssText =
          "position:fixed;inset:0;width:100%;height:100%;pointer-events:none;z-index:9999";
        document.body.appendChild(canvas);

        const maybeCtx = canvas.getContext("2d");
        if (!maybeCtx) {
          canvas.remove();
          return;
        }
        const ctx: CanvasRenderingContext2D = maybeCtx;
        const dpr = window.devicePixelRatio || 1;
        canvas.width = window.innerWidth * dpr;
        canvas.height = window.innerHeight * dpr;

        const colors = ["#2d5db0", "#e05243", "#f4b400", "#0f9d58", "#ffffff"];
        const pieces = Array.from({ length: 150 }, () => ({
          x: Math.random() * canvas.width,
          y: -canvas.height * 0.3 * Math.random() - 20,
          size: (6 + Math.random() * 6) * dpr,
          color: colors[(Math.random() * colors.length) | 0],
          vx: (Math.random() - 0.5) * 3 * dpr,
          vy: (2 + Math.random() * 4) * dpr,
          rot: Math.random() * Math.PI,
          vr: (Math.random() - 0.5) * 0.3,
        }));

        const start = performance.now();
        function frame(now: number) {
          const elapsed = now - start;
          ctx.clearRect(0, 0, canvas.width, canvas.height);
          for (const p of pieces) {
            p.vy += 0.05 * dpr;
            p.x += p.vx;
            p.y += p.vy;
            p.rot += p.vr;
            ctx.save();
            ctx.translate(p.x, p.y);
            ctx.rotate(p.rot);
            ctx.fillStyle = p.color;
            ctx.fillRect(-p.size / 2, -p.size / 2, p.size, p.size * 0.6);
            ctx.restore();
          }
          if (elapsed < 2800) requestAnimationFrame(frame);
          else canvas.remove();
        }
        requestAnimationFrame(frame);
      }

      window.addEventListener("keydown", (event) => {
        const key = event.key.length === 1 ? event.key.toLowerCase() : event.key;
        if (key === sequence[position]) {
          position += 1;
          if (position === sequence.length) {
            position = 0;
            launchConfetti();
          }
        } else {
          position = key === sequence[0] ? 1 : 0;
        }
      });

      // Touch analog of the Konami code: the same arrow pattern, swiped.
      type SwipeDirection = "up" | "down" | "left" | "right";
      const swipeSequence: SwipeDirection[] = [
        "up",
        "up",
        "down",
        "down",
        "left",
        "right",
        "left",
        "right",
      ];
      const MIN_SWIPE_DISTANCE = 24;
      // How much one axis must lead the other before we commit to a
      // direction. Below this, a near-45° stroke is ambiguous and we wait
      // for more movement instead of guessing (and possibly guessing wrong).
      const AXIS_DOMINANCE = 1.2;
      let swipePosition = 0;
      let activeTouchId: number | null = null;
      let segmentStartX = 0;
      let segmentStartY = 0;

      function swipeDirection(dx: number, dy: number): SwipeDirection | null {
        const absX = Math.abs(dx);
        const absY = Math.abs(dy);
        if (Math.max(absX, absY) < MIN_SWIPE_DISTANCE) return null;
        if (absX > absY * AXIS_DOMINANCE) return dx > 0 ? "right" : "left";
        if (absY > absX * AXIS_DOMINANCE) return dy > 0 ? "down" : "up";
        return null;
      }

      function findActiveTouch(touches: TouchList): Touch | null {
        for (let i = 0; i < touches.length; i++) {
          if (touches[i].identifier === activeTouchId) return touches[i];
        }
        return null;
      }

      function registerSwipe(direction: SwipeDirection) {
        if (direction === swipeSequence[swipePosition]) {
          swipePosition += 1;
          if (swipePosition === swipeSequence.length) {
            swipePosition = 0;
            launchConfetti();
          }
        } else {
          swipePosition = direction === swipeSequence[0] ? 1 : 0;
        }
      }

      window.addEventListener(
        "touchstart",
        (event) => {
          const touch = event.changedTouches[0];
          if (!touch) return;
          activeTouchId = touch.identifier;
          segmentStartX = touch.clientX;
          segmentStartY = touch.clientY;
        },
        { passive: true },
      );

      // Detect direction on touchmove rather than waiting for touchend: a
      // fast fling is often handed off to native scrolling mid-gesture,
      // which fires touchcancel instead of touchend and would otherwise
      // drop the swipe entirely. Once a segment resolves to a direction, the
      // start point resets to the current position so one continuous drag
      // (e.g. a zigzag without lifting the finger) can register the whole
      // multi-swipe sequence, not just its first stroke.
      window.addEventListener(
        "touchmove",
        (event) => {
          if (activeTouchId === null) return;
          const touch = findActiveTouch(event.changedTouches);
          if (!touch) return;

          const direction = swipeDirection(
            touch.clientX - segmentStartX,
            touch.clientY - segmentStartY,
          );
          if (!direction) return;

          registerSwipe(direction);
          segmentStartX = touch.clientX;
          segmentStartY = touch.clientY;
        },
        { passive: true },
      );

      function resetSwipeTracking() {
        activeTouchId = null;
      }

      window.addEventListener("touchend", resetSwipeTracking, { passive: true });
      window.addEventListener("touchcancel", resetSwipeTracking, {
        passive: true,
      });
    </script>
  </body>
</html>
